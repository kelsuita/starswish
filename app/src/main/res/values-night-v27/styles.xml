<resources>
    <!-- Match the in-app dark surface so the window does not flash light before Compose draws. -->
    <style name="Theme.StarSavings" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#3975F6</item>
        <item name="android:windowBackground">#121212</item>
    </style>
</resources>
